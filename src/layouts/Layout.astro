---
import '../styles/global.css';
import { waLink as buildWaLink, SITE_CONFIG } from '../config';

interface Props {
  title: string;
  lang?: string;
  description?: string;
}

const { title, lang = 'es', description = '' } = Astro.props;
const path = Astro.url.pathname;
const waLink = buildWaLink(lang);

const isActive = (href: string) => {
  if (href === '/' || href === '/en/') return path === href || path === href.replace(/\/$/, '');
  return path === href || path.startsWith(href + '/');
};

const navES = [
  { href: '/quienes-somos', label: 'Quiénes somos', cta: false },
  { href: '/equipo', label: 'Equipo', cta: false },
  { href: '/tratamientos', label: 'Tratamientos', cta: false },
  { href: '/promociones', label: 'Promociones', cta: false },
  { href: '/testimonios', label: 'Testimonios', cta: false },
  { href: '/cita', label: 'Pida su cita', cta: true },
];
const navEN = [
  { href: '/en/about', label: 'About Us', cta: false },
  { href: '/en/team', label: 'Team', cta: false },
  { href: '/en/treatments', label: 'Treatments', cta: false },
  { href: '/en/promotions', label: 'Promotions', cta: false },
  { href: '/en/testimonials', label: 'Testimonials', cta: false },
  { href: '/en/appointment', label: 'Book Appointment', cta: true },
];
const nav = lang === 'en' ? navEN : navES;

const homeHref = lang === 'en' ? '/en/' : '/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description || 'DDX – Digital Dental Xperts. Clínica dental de vanguardia comprometida con la excelencia en cada sonrisa.'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
  </head>
  <body>

    <header>
      <div class="header-inner">
        <a href={homeHref} class="logo" aria-label="DDX Digital Dental Xperts – inicio">
          <!-- Animated digital implant surgery icon -->
          <svg class="logo-anim" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <ellipse cx="32" cy="32" rx="28" ry="10" stroke="rgba(91,143,168,0.45)" stroke-width="1" fill="none" class="ring-outer"/>
            <ellipse cx="32" cy="32" rx="20" ry="7" stroke="rgba(91,143,168,0.7)" stroke-width="1" fill="none" class="ring-mid"/>
            <line x1="32" y1="4"  x2="32" y2="18" stroke="#5b8fa8" stroke-width="1" stroke-dasharray="2 2" opacity=".6"/>
            <line x1="32" y1="46" x2="32" y2="60" stroke="#5b8fa8" stroke-width="1" stroke-dasharray="2 2" opacity=".6"/>
            <line x1="4"  y1="32" x2="18" y2="32" stroke="#5b8fa8" stroke-width="1" stroke-dasharray="2 2" opacity=".6"/>
            <line x1="46" y1="32" x2="60" y2="32" stroke="#5b8fa8" stroke-width="1" stroke-dasharray="2 2" opacity=".6"/>
            <rect x="27" y="14" width="10" height="26" rx="5" fill="url(#ddxImplantGrad)"/>
            <line x1="27" y1="22" x2="37" y2="22" stroke="rgba(255,255,255,0.35)" stroke-width="1"/>
            <line x1="27" y1="26" x2="37" y2="26" stroke="rgba(255,255,255,0.35)" stroke-width="1"/>
            <line x1="27" y1="30" x2="37" y2="30" stroke="rgba(255,255,255,0.35)" stroke-width="1"/>
            <line x1="27" y1="34" x2="37" y2="34" stroke="rgba(255,255,255,0.35)" stroke-width="1"/>
            <polygon points="27,40 37,40 32,47" fill="url(#ddxImplantGrad)"/>
            <rect x="25" y="11" width="14" height="5" rx="2" fill="#a8cfe0"/>
            <ellipse cx="32" cy="10" rx="8" ry="5" fill="url(#ddxCrownGrad)" class="crown"/>
            <circle cx="32" cy="32" r="2" fill="#5b8fa8" class="target-dot"/>
            <circle cx="60" cy="32" r="3" fill="#5b8fa8" class="orbit-dot"/>
            <defs>
              <linearGradient id="ddxImplantGrad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%"   stop-color="#3e6478"/>
                <stop offset="50%"  stop-color="#a8cfe0"/>
                <stop offset="100%" stop-color="#5b8fa8"/>
              </linearGradient>
              <linearGradient id="ddxCrownGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%"   stop-color="#eaf2f7"/>
                <stop offset="100%" stop-color="#a8cfe0"/>
              </linearGradient>
            </defs>
          </svg>
          <div class="logo-text-block">
            <span class="logo-ddx">DDX</span>
            <span class="logo-sub">Digital Dental Xperts</span>
          </div>
        </a>

        <nav class="nav-tabs" aria-label="Navegación principal">
          {nav.map(n => (
            n.cta
              ? <a href={n.href} class:list={['nav-link-cta', { active: isActive(n.href) }]}>{n.label}</a>
              : <a href={n.href} class:list={['nav-link', { active: isActive(n.href) }]}>{n.label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <div class="lang-switcher" aria-label="Cambiar idioma">
            <a href="/" class:list={['btn-lang', { active: lang === 'es' }]} hreflang="es">ES</a>
            <a href="/en/" class:list={['btn-lang', { active: lang === 'en' }]} hreflang="en">EN</a>
          </div>
          <button id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-nav">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <div id="mobile-nav" role="dialog" aria-modal="true" aria-label="Menú de navegación">
      <div id="mobile-nav-inner">
        <div class="mob-lang-row">
          <a href="/" class:list={['btn-lang', { active: lang === 'es' }]}>ES</a>
          <a href="/en/" class:list={['btn-lang', { active: lang === 'en' }]}>EN</a>
        </div>
        {nav.map(n => (
          n.cta
            ? <a href={n.href} class:list={['mob-nav-cta', { active: isActive(n.href) }]}>{n.label}</a>
            : <a href={n.href} class:list={['mob-nav-link', { active: isActive(n.href) }]}>{n.label}</a>
        ))}
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div>
          <img id="footer-logo" src="/logos/logo-white.png" alt="DDX Digital Dental Xperts" height="40" style="display:block; max-width:180px; width:auto; margin-bottom:8px;" />
          <span id="footer-logo-fallback" class="footer-logo" style="display:none;">DDX</span>
          <p class="footer-desc">Clínica dental de vanguardia comprometida con la excelencia y la innovación en cada sonrisa.</p>
          <p class="footer-desc" style="margin-top:10px; font-size:.72rem;">digitaldentalxperts.com</p>
        </div>
        <div>
          <div class="footer-heading">{lang === 'en' ? 'Navigation' : 'Navegación'}</div>
          <ul class="footer-links">
            {nav.map(n => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
        </div>
        <div>
          <div class="footer-heading">{lang === 'en' ? 'Contact' : 'Contacto'}</div>
          <div class="footer-contact-row">
            <span class="footer-contact-icon">📞</span>
            <span class="footer-contact-text">{SITE_CONFIG.phone}</span>
          </div>
          <div class="footer-contact-row">
            <span class="footer-contact-icon">✉</span>
            <span class="footer-contact-text">{SITE_CONFIG.email}</span>
          </div>
          <div class="footer-contact-row">
            <span class="footer-contact-icon">📍</span>
            <span class="footer-contact-text">{SITE_CONFIG.address}<br/>{SITE_CONFIG.city}</span>
          </div>
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-wa-footer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            {lang === 'en' ? 'WhatsApp us' : 'Escríbenos por WhatsApp'}
          </a>
        </div>
      </div>

      <div class="footer-social-row">
        <span class="footer-social-label">{lang === 'en' ? 'Follow us' : 'Síguenos'}</span>
        <a href="#" aria-label="Instagram" class="social-icon">IG</a>
        <a href="#" aria-label="Facebook" class="social-icon">FB</a>
        <a href="#" aria-label="LinkedIn" class="social-icon">LI</a>
      </div>

      <div class="footer-bottom">
        © {new Date().getFullYear()} DDX Digital Dental Xperts · digitaldentalxperts.com
      </div>
    </footer>

    <!-- WhatsApp FAB -->
    <a href={waLink} target="_blank" rel="noopener noreferrer" class="wa-fab" aria-label="Contactar por WhatsApp">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="white">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

    <!-- Opening Announcement Popup -->
    <div id="opening-popup" class="popup-overlay" role="dialog" aria-modal="true" aria-labelledby="popup-title">
      <div class="popup-card">
        <div class="popup-eyebrow">{lang === 'en' ? 'Grand Opening' : 'Gran Apertura'}</div>
        <div class="popup-logo-line">
          <span class="popup-ddx">DDX</span>
        </div>
        <h2 class="popup-title" id="popup-title">
          {lang === 'en' ? 'We open our doors' : 'Abrimos nuestras puertas'}
        </h2>
        <div class="popup-date">
          <span class="popup-date-day">1</span>
          <span class="popup-date-sep">·</span>
          <span class="popup-date-month">{lang === 'en' ? 'August' : 'Agosto'}</span>
          <span class="popup-date-sep">·</span>
          <span class="popup-date-year">2026</span>
        </div>
        <p class="popup-sub">
          {lang === 'en'
            ? 'DDX Digital Dental Xperts — Technology and care in service of your smile. Cornellà de Llobregat, Barcelona.'
            : 'DDX Digital Dental Xperts — Tecnología y humanidad al servicio de su sonrisa. Cornellà de Llobregat, Barcelona.'}
        </p>
        <div class="popup-actions">
          <a href={lang === 'en' ? '/en/appointment' : '/cita'} class="popup-btn-primary" id="popup-cta">
            {lang === 'en' ? 'Book your first visit' : 'Reserve su primera visita'}
          </a>
          <button class="popup-btn-close" id="popup-close">
            {lang === 'en' ? 'Explore the clinic' : 'Explorar la clínica'}
          </button>
        </div>
        <button class="popup-x" id="popup-x" aria-label={lang === 'en' ? 'Close' : 'Cerrar'}>✕</button>
      </div>
    </div>

    <script>
      (() => {
        const logo = document.getElementById('header-logo');
        const logoFallback = document.getElementById('header-logo-fallback');
        const attachLogoFallback = (imgId: string, fallbackId: string) => {
          const img = document.getElementById(imgId);
          const fallback = document.getElementById(fallbackId);
          if (img && fallback) {
            img.addEventListener('error', () => {
              img.style.display = 'none';
              fallback.style.display = 'block';
            });
          }
        };
        attachLogoFallback('header-logo', 'header-logo-fallback');
        attachLogoFallback('footer-logo', 'footer-logo-fallback');
      })();
      (() => {
        const btn = document.getElementById('hamburger');
        const overlay = document.getElementById('mobile-nav');
        if (!btn || !overlay) return;
        const open = () => {
          btn.classList.add('open');
          overlay.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        };
        const close = () => {
          btn.classList.remove('open');
          overlay.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        };
        btn.addEventListener('click', () => btn.classList.contains('open') ? close() : open());
        overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
        overlay.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
      })();
      (() => {
        const POPUP_KEY = 'ddx_opening_dismissed';
        const popup = document.getElementById('opening-popup');
        if (!popup) return;
        if (sessionStorage.getItem(POPUP_KEY)) {
          popup.classList.add('popup-hidden');
          return;
        }
        popup.classList.add('popup-visible');
        const dismiss = () => {
          popup.classList.remove('popup-visible');
          popup.classList.add('popup-hidden');
          sessionStorage.setItem(POPUP_KEY, '1');
        };
        document.getElementById('popup-close')?.addEventListener('click', dismiss);
        document.getElementById('popup-x')?.addEventListener('click', dismiss);
        document.getElementById('popup-cta')?.addEventListener('click', dismiss);
        popup.addEventListener('click', (e) => { if (e.target === popup) dismiss(); });
      })();
    </script>
  </body>
</html>
