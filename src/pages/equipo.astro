---
import Layout from '../layouts/Layout.astro';

const doctors = [
  {
    name: 'Dr. Juan Méndez Rivas',
    specialty: 'Implantología y Cirugía Oral',
    credentials: 'Universidad Autónoma de Santo Domingo · Máster en Implantología y Rehabilitación Oral (ESORIB, Madrid)',
    bio: 'Director de programa con formación en implantología en París XII, Barcelona y Madrid. Especialista en cirugía guiada digital 3D, carga inmediata All-on-Four y regeneración ósea guiada. Ex director del Programa Internacional de Implantología en CIDESID, Barcelona (2000–2020). Colaborador docente del Máster en Implantología de la Universidad Internacional de Cataluña.',
    photo: '/team/juan-mendez-rivas.jpg',
  },
  {
    name: 'Dr. Manuel González',
    specialty: 'Implantología y Rehabilitación Oral',
    credentials: 'Licenciado en Odontología, Universidad de Murcia · Máster en Implantología y Prótesis · Especialista en Estética Perioral (UCAM)',
    bio: 'Director de programa con sede en Murcia. Premio al mejor expediente en su Máster en Implantología y Prótesis sobre Implantes. Especialista en implantología guiada digital, cirugía guiada 3D, rehabilitación oral e implantaria y estética perioral. Máster en Oclusión y Rehabilitación Oral por el Prof. Dr. Aníbal Alonso.',
    photo: '/team/manuel-gonzales.jpg',
  },
  {
    name: 'Dra. [Nombre Apellido]',
    specialty: 'Estética Dental y Prótesis',
    credentials: '[Universidad] · [Especialidad en Prótesis]',
    bio: 'Especializada en diseño de sonrisa digital, carillas de porcelana y restauraciones estéticas. Enfoque en resultados naturales y duraderos.',
    photo: null,
  },
  {
    name: 'Dra. [Nombre Apellido]',
    specialty: 'Periodoncia y Salud Gingival',
    credentials: '[Universidad] · [Máster en Periodoncia]',
    bio: 'Especialista en el tratamiento de enfermedades periodontales y regeneración ósea. Enfoque preventivo y tratamientos con láser de última generación.',
    photo: null,
  },
  {
    name: 'Dr. [Nombre Apellido]',
    specialty: 'Odontología General y Diagnóstico Digital',
    credentials: '[Universidad] · [Años de experiencia]',
    bio: 'Responsable del diagnóstico digital y coordinación clínica. Uso de TAC 3D y escáneres intraorales para planificaciones precisas e individualizadas.',
    photo: null,
  },
  {
    name: 'Dra. [Nombre Apellido]',
    specialty: 'Odontología Infantil y Preventiva',
    credentials: '[Universidad] · [Especialidad Pediatría Dental]',
    bio: 'Especialista en atención dental infantil con técnicas adaptadas para los más pequeños. Ambiente amigable y enfoque preventivo desde las primeras visitas.',
    photo: null,
  },
];
---

<Layout title="Nuestro equipo – DDX Digital Dental Experts" lang="es" description="Conozca al equipo de especialistas de DDX Digital Dental Experts. Profesionales comprometidos con su salud dental.">

  <!-- PAGE HERO -->
  <div class="page-hero" style="padding:40px 32px 32px;">
    <span class="eyebrow">Especialistas</span>
    <h1 class="page-h1" style="font-size:2.2rem; margin-top:8px;">Nuestro equipo</h1>
    <div class="divider-bar" style="margin:12px auto 0;"></div>
  </div>

  <!-- TEAM GRID -->
  <div class="sec-white">
    <div class="section">
      <div class="grid-3">
        {doctors.map(doc => (
          <div class="card">
            {doc.photo
              ? <img src={doc.photo} alt={`Foto de ${doc.name}`} style="width:100%; height:420px; object-fit:cover; object-position:center 40%; display:block;" />
              : <div class="doctor-placeholder"><span>Foto del doctor</span></div>
            }
            <div class="card-body">
              <span class="specialty-tag">{doc.specialty}</span>
              <h3 class="sec-h3" style="margin-bottom:4px;">{doc.name}</h3>
              <p style="font-size:.72rem; color:var(--silver); margin-bottom:12px; text-transform:uppercase; letter-spacing:1px;">{doc.credentials}</p>
              <p class="lead">{doc.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- TEAM PHILOSOPHY -->
  <div class="sec-light">
    <div class="section">
      <div class="grid-2">
        <div>
          <span class="eyebrow">Formación continua</span>
          <h2 class="sec-h2">Siempre a la vanguardia</h2>
          <div class="divider-bar"></div>
          <p class="lead">Todo nuestro equipo participa regularmente en congresos, cursos y formaciones de posgrado nacionales e internacionales. La actualización constante nos permite ofrecer siempre las técnicas y materiales más innovadores.</p>
          <p class="lead" style="margin-top:14px;">Colaboramos con centros de referencia europeos y nos regimos por los protocolos clínicos más exigentes del sector.</p>
        </div>
        <div class="img-frame-placeholder" style="height:360px;">
          <span>Foto del equipo / formación</span>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="cta-banner">
    <div class="cta-banner-inner">
      <span class="eyebrow-dark">Conózcanos en persona</span>
      <h2 class="sec-h2-white">¿Quiere conocernos y resolver sus dudas?</h2>
      <p class="lead-white" style="margin-top:14px;">Solicite una primera consulta sin compromiso. Estaremos encantados de recibirle.</p>
      <div class="cta-actions">
        <a href="/cita" class="btn btn-white btn-lg">Pida su cita</a>
        <a href="/tratamientos" class="btn btn-outline-white btn-lg">Ver tratamientos</a>
      </div>
    </div>
  </div>

</Layout>
