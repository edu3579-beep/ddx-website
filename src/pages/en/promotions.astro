---
import Layout from '../../layouts/Layout.astro';

const promos = [
  { badge: 'New patients', title: 'Free first consultation', description: 'Complete oral examination, personalised diagnosis and treatment plan at no cost. Meet us with no obligation.', validity: 'Valid while places last', cta: 'Book now' },
  { badge: 'Whitening', title: 'Whitening plan with discount', description: 'Professional in-clinic whitening + home maintenance kit at a special discount for new patients.', validity: 'Ask for conditions in clinic', cta: 'Request information' },
  { badge: 'Full check-up', title: 'Check-up + panoramic X-ray', description: 'Complete examination with periodontal review and digital panoramic X-ray included. Ideal for patients who don\'t visit the dentist regularly.', validity: 'Special price · Ask at reception', cta: 'Book appointment' },
  { badge: 'Financing', title: 'Interest-free financing', description: 'Split the cost of your treatment into comfortable monthly instalments with no interest. Available for implants, orthodontics and cosmetic treatments.', validity: 'Subject to approval · See conditions', cta: 'More information' },
];
---

<Layout title="Promotions – DDX Digital Dental Xperts" lang="en" description="Special offers at DDX Digital Dental Xperts. Free first consultation and interest-free financing.">

  <div class="page-hero">
    <span class="eyebrow">Special offers</span>
    <h1 class="page-h1">Promotions</h1>
    <div class="divider-bar" style="margin:16px auto 0;"></div>
    <p class="lead" style="max-width:560px; margin:16px auto 0;">Special conditions so you can access the best dental care with maximum convenience and flexible payment options.</p>
  </div>

  <div class="sec-white">
    <div class="section">
      <div class="grid-2">
        {promos.map(p => (
          <div class="promo-card">
            <div class="promo-card-top"></div>
            <div class="promo-card-body">
              <span class="promo-badge">{p.badge}</span>
              <h2 class="sec-h3" style="margin-bottom:10px; margin-top:4px;">{p.title}</h2>
              <p class="lead">{p.description}</p>
              <p class="promo-validity">📅 {p.validity}</p>
              <a href="/en/appointment" class="btn btn-dark" style="margin-top:20px;">{p.cta}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="sec-light">
    <div class="section-sm">
      <div style="max-width:720px; margin:0 auto;">
        <h3 class="sec-h3" style="margin-bottom:16px;">Terms and conditions</h3>
        <p class="lead">* Promotions are subject to availability and may change without notice. Cannot be combined with other offers. Please ask our reception team for full details of each promotion and current availability.</p>
        <p class="lead" style="margin-top:10px;">* Interest-free financing is subject to approval by our partner financial institution. Conditions vary by amount and term chosen.</p>
      </div>
    </div>
  </div>

  <div class="cta-banner">
    <div class="cta-banner-inner">
      <span class="eyebrow-dark">No obligation</span>
      <h2 class="sec-h2-white">Would you like to take advantage of one of these offers?</h2>
      <p class="lead-white" style="margin-top:14px;">Contact us today and we'll tell you about all available options.</p>
      <div class="cta-actions">
        <a href="/en/appointment" class="btn btn-white btn-lg">Book an appointment</a>
      </div>
    </div>
  </div>

</Layout>
