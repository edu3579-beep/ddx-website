---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Request received – DDX Digital Dental Xperts" lang="en" description="We have received your appointment request. We will contact you within 24 hours.">

  <div style="min-height:60vh; display:flex; align-items:center; justify-content:center; padding:80px 32px;">
    <div style="text-align:center; max-width:540px;">
      <div style="font-size:3rem; margin-bottom:24px;">✓</div>
      <span class="eyebrow">Request sent</span>
      <h1 class="sec-h2" style="margin-top:8px; margin-bottom:16px;">Thank you! We've received your request</h1>
      <p class="lead">We will contact you within 24 hours during business hours to confirm your appointment.</p>
      <p class="lead" style="margin-top:12px;">If you need urgent assistance, you can write to us on WhatsApp and we'll reply within minutes.</p>
      <div style="display:flex; gap:14px; justify-content:center; flex-wrap:wrap; margin-top:32px;">
        <a href="/en/" class="btn btn-dark">Back to home</a>
        <a href="/en/treatments" class="btn btn-outline">View treatments</a>
      </div>
    </div>
  </div>

</Layout>
