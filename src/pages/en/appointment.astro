---
import Layout from '../../layouts/Layout.astro';
import { waLink, SITE_CONFIG } from '../../config';

const waHref = waLink('en');
const formAction = SITE_CONFIG.formspreeId
  ? `https://formspree.io/f/${SITE_CONFIG.formspreeId}`
  : '#form-not-configured';
---

<Layout title="Book an Appointment – DDX Digital Dental Xperts" lang="en" description="Book your appointment at DDX Digital Dental Xperts. Online form, WhatsApp or phone. Reply within 24 hours.">

  <div class="page-hero">
    <span class="eyebrow">Contact</span>
    <h1 class="page-h1">Book an Appointment</h1>
    <div class="divider-bar" style="margin:16px auto 0;"></div>
    <p class="lead" style="max-width:520px; margin:16px auto 0;">We're here to help. Contact us however you prefer and we'll get back to you within 24 hours.</p>
  </div>

  <div class="sec-light" style="border-bottom:1px solid var(--silver-light);">
    <div class="container">
      <div class="grid-3" style="padding:0;">
        <div class="contact-option">
          <div class="contact-option-icon">📋</div>
          <div class="contact-option-label">Online form</div>
          <div class="contact-option-value"><a href="#form" style="color:var(--accent); font-size:.85rem;">Fill in the form →</a></div>
        </div>
        <div class="contact-option" style="border-left:1px solid var(--silver-light); border-right:1px solid var(--silver-light);">
          <div class="contact-option-icon">💬</div>
          <div class="contact-option-label">WhatsApp</div>
          <div class="contact-option-value"><a href={waHref} target="_blank" rel="noopener noreferrer" style="color:var(--wa-green); font-size:.85rem;">Write to us now →</a></div>
        </div>
        <div class="contact-option">
          <div class="contact-option-icon">📞</div>
          <div class="contact-option-label">Phone</div>
          <div class="contact-option-value">{SITE_CONFIG.phone}</div>
        </div>
      </div>
    </div>
  </div>

  <div class="sec-white">
    <div class="section">
      <div class="grid-2-3" id="form">

        <div class="form-card">
          <span class="eyebrow">Appointment request</span>
          <h2 class="sec-h2" style="margin-bottom:28px;">Fill in the form</h2>

          <form action={formAction} method="POST" style="display:flex; flex-direction:column; gap:20px;">
            <input type="hidden" name="_next" value="/en/thank-you" />
            <input type="hidden" name="_subject" value="New appointment request – DDX Digital Dental Xperts" />

            <div class="form-group">
              <label class="form-label" for="name">Full name *</label>
              <input class="form-input" type="text" id="name" name="name" required placeholder="Your full name" autocomplete="name" />
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label class="form-label" for="phone">Phone *</label>
                <input class="form-input" type="tel" id="phone" name="phone" required placeholder="+34 600 000 000" autocomplete="tel" />
              </div>
              <div class="form-group">
                <label class="form-label" for="email">Email *</label>
                <input class="form-input" type="email" id="email" name="email" required placeholder="your@email.com" autocomplete="email" />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="treatment">Treatment of interest *</label>
              <select class="form-input form-select" id="treatment" name="treatment" required>
                <option value="" disabled selected>-- Select a treatment --</option>
                <option value="implants">Dental implants</option>
                <option value="orthodontics">Orthodontics / Invisalign</option>
                <option value="cosmetic">Cosmetic dentistry</option>
                <option value="periodontics">Periodontics</option>
                <option value="diagnostics">Digital diagnostics</option>
                <option value="paediatric">Paediatric dentistry</option>
                <option value="first-consultation">General first consultation</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="schedule">Preferred schedule</label>
              <select class="form-input form-select" id="schedule" name="schedule">
                <option value="flexible">Flexible</option>
                <option value="morning">Morning (9:00–13:00)</option>
                <option value="afternoon">Afternoon (15:00–20:00)</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="message">Message or comments</label>
              <textarea class="form-input" id="message" name="message" rows="4" placeholder="Tell us briefly about your case or any questions you have…"></textarea>
            </div>

            <div class="form-checkbox-row">
              <input type="checkbox" id="privacy" name="privacy" required />
              <label class="form-checkbox-label" for="privacy">
                I have read and accept the <a href="/en/privacy-policy" style="color:var(--accent); text-decoration:underline;">privacy policy</a>. I consent to my data being processed to handle my appointment request.
              </label>
            </div>

            <button type="submit" class="btn btn-dark btn-full btn-lg">
              Send appointment request →
            </button>

            <p style="font-size:.72rem; color:var(--text-muted); text-align:center;">
              We'll reply within 24 hours during business hours.
            </p>
          </form>
        </div>

        <div class="info-panel">
          <div class="info-block info-block-wa">
            <div class="info-heading">Prefer WhatsApp?</div>
            <h3 class="sec-h3" style="margin-bottom:8px;">Write to us now</h3>
            <p class="lead" style="margin-bottom:16px;">We reply within minutes. You can also send us photos of your case for a preliminary assessment.</p>
            <a href={waHref} target="_blank" rel="noopener noreferrer" class="btn btn-wa btn-full btn-lg">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Open WhatsApp
            </a>
          </div>

          <div class="info-block">
            <div class="info-heading">Contact information</div>
            <div class="info-row"><span class="info-icon">📞</span><span class="info-text">{SITE_CONFIG.phone}</span></div>
            <div class="info-row"><span class="info-icon">✉</span><span class="info-text">{SITE_CONFIG.email}</span></div>
            <div class="info-row"><span class="info-icon">📍</span><span class="info-text">{SITE_CONFIG.address}<br/>{SITE_CONFIG.city}</span></div>
          </div>

          <div class="info-block">
            <div class="info-heading">Opening hours</div>
            <div class="hours-grid">
              <span class="hours-day">Mon – Fri</span><span class="hours-time">9:00 – 20:00</span>
              <span class="hours-day">Saturday</span><span class="hours-time">9:00 – 14:00</span>
              <span class="hours-day">Sunday</span><span class="hours-time">Closed</span>
            </div>
          </div>

          <div class="map-placeholder"><span>Google Maps embed</span></div>
        </div>
      </div>
    </div>
  </div>

</Layout>
