---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="DDX Digital Dental Xperts – Advanced Dental Clinic" lang="en" description="DDX Digital Dental Xperts, specialist dental clinic for implants, orthodontics and cosmetic dentistry. Book your appointment today.">

  <!-- HERO -->
  <div class="hero">
    <div class="hero-content">
      <span class="eyebrow">Dental Clinic · [City]</span>
      <h1 class="page-h1">
        Excellence<br/>
        in <em style="font-style:italic; color:var(--accent);">your smile</em>
      </h1>
      <div class="divider-bar"></div>
      <p class="lead" style="max-width:460px;">
        At DDX we combine cutting-edge digital technology with the expertise of our specialists to deliver outstanding results and a unique patient experience.
      </p>
      <div class="hero-ctas">
        <a href="/en/appointment" class="btn btn-dark btn-lg">Book an appointment</a>
        <a href="/en/treatments" class="btn btn-outline btn-lg">Our treatments</a>
      </div>
    </div>
    <div class="hero-img">
      <img src="/images/clinic-hero.jpg" alt="DDX Digital Dental Xperts reception" class="hero-clinic-img" />
    </div>
  </div>


  <!-- ABOUT TEASER -->
  <div class="sec-white">
    <div class="section">
      <div class="grid-2">
        <div>
          <span class="eyebrow">About us</span>
          <h2 class="sec-h2">Technology and care in service of your dental health</h2>
          <div class="divider-bar"></div>
          <p class="lead">DDX Digital Dental Xperts is a leading clinic committed to innovation and personalised care. Our team of specialists uses the most advanced diagnostic and treatment systems to ensure the best outcomes.</p>
          <p class="lead" style="margin-top:14px;">From the first consultation to post-treatment follow-up, we accompany you every step of the way with transparency and professionalism.</p>
          <a href="/en/about" class="btn btn-dark" style="margin-top:28px;">Learn more about us</a>
        </div>
        <div>
          <img src="/images/about-hero.jpg" alt="DDX Digital Dental Xperts team planning digital treatment" class="treatment-img" />
        </div>
      </div>
    </div>
  </div>

  <!-- TREATMENTS PREVIEW -->
  <div class="sec-light">
    <div class="section">
      <div class="grid-2" style="align-items:start; gap:48px;">
        <div>
          <span class="eyebrow">Our treatments</span>
          <h2 class="sec-h2">Comprehensive dental solutions</h2>
          <div class="divider-bar"></div>
          <p class="lead">We offer a wide range of treatments to care for your oral health and transform your smile.</p>
          <a href="/en/treatments" class="btn btn-dark" style="margin-top:24px;">View all treatments</a>
        </div>
        <ul class="bullet-list">
          <li>🦷 Dental Implants</li>
          <li>😁 Orthodontics & Invisalign</li>
          <li>✨ Cosmetic Dentistry & Smile Design</li>
          <li>🩺 Periodontics & Gum Health</li>
          <li>📡 3D Digital Diagnostics</li>
          <li>👶 Paediatric & Preventive Dentistry</li>
        </ul>
      </div>
    </div>
  </div>


  <!-- CTA BANNER -->
  <div class="cta-banner">
    <div class="cta-banner-inner">
      <span class="eyebrow-dark">DDX Digital Dental Xperts</span>
      <h2 class="sec-h2-white">Ready to transform your smile?</h2>
      <p class="lead-white" style="margin-top:14px;">Book your appointment today and take the first step towards the smile you've always wanted.</p>
      <div class="cta-actions">
        <a href="/en/appointment" class="btn btn-white btn-lg">Book an appointment</a>
      </div>
    </div>
  </div>

</Layout>
