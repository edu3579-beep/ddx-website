---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="DDX Digital Dental Xperts – Advanced Dental Clinic" lang="en" description="DDX Digital Dental Xperts, specialist dental clinic for implants, orthodontics and cosmetic dentistry. Book your appointment today.">

  <!-- HERO -->
  <div class="hero">
    <div class="hero-content">
      <span class="eyebrow">Dental Clinic · [City]</span>
      <h1 class="page-h1">
        Excellence<br/>
        in <em style="font-style:italic; color:var(--accent);">your smile</em>
      </h1>
      <div class="divider-bar"></div>
      <p class="lead" style="max-width:460px;">
        At DDX we combine cutting-edge digital technology with the expertise of our specialists to deliver outstanding results and a unique patient experience.
      </p>
      <div class="hero-ctas">
        <a href="/en/appointment" class="btn btn-dark btn-lg">Book an appointment</a>
        <a href="/en/treatments" class="btn btn-outline btn-lg">Our treatments</a>
      </div>
    </div>
    <div class="hero-img">
      <div class="hero-placeholder">
        <span>Main clinic photo</span>
      </div>
    </div>
  </div>

  <!-- STATS STRIP -->
  <div class="stat-strip">
    <div class="stat-strip-inner">
      <div>
        <div class="stat-val">+15</div>
        <div class="stat-lbl">Years of experience</div>
      </div>
      <div>
        <div class="stat-val">+5,000</div>
        <div class="stat-lbl">Happy patients</div>
      </div>
      <div>
        <div class="stat-val">12</div>
        <div class="stat-lbl">Specialties</div>
      </div>
      <div>
        <div class="stat-val">★ 4.9</div>
        <div class="stat-lbl">Average rating</div>
      </div>
    </div>
  </div>

  <!-- ABOUT TEASER -->
  <div class="sec-white">
    <div class="section">
      <div class="grid-2">
        <div>
          <span class="eyebrow">About us</span>
          <h2 class="sec-h2">Technology and care in service of your dental health</h2>
          <div class="divider-bar"></div>
          <p class="lead">DDX Digital Dental Xperts is a leading clinic committed to innovation and personalised care. Our team of specialists uses the most advanced diagnostic and treatment systems to ensure the best outcomes.</p>
          <p class="lead" style="margin-top:14px;">From the first consultation to post-treatment follow-up, we accompany you every step of the way with transparency and professionalism.</p>
          <a href="/en/about" class="btn btn-dark" style="margin-top:28px;">Learn more about us</a>
        </div>
        <div class="img-frame-placeholder" style="height:420px;">
          <span>Clinic / team photo</span>
        </div>
      </div>
    </div>
  </div>

  <!-- TREATMENTS PREVIEW -->
  <div class="sec-light">
    <div class="section">
      <div class="center" style="margin-bottom:44px;">
        <span class="eyebrow">Our treatments</span>
        <h2 class="sec-h2">Comprehensive dental solutions</h2>
        <div class="divider-bar"></div>
        <p class="lead" style="max-width:560px; margin:0 auto;">We offer a wide range of treatments to care for your oral health and transform your smile.</p>
      </div>
      <div class="grid-3">
        {[
          { icon: '🦷', title: 'Dental Implants', desc: 'Fixed, permanent solutions for missing teeth using state-of-the-art digital planning technology.' },
          { icon: '😁', title: 'Orthodontics', desc: 'Braces and invisible aligners for a perfectly aligned smile tailored to your lifestyle.' },
          { icon: '✨', title: 'Cosmetic Dentistry', desc: 'Whitening, veneers, and smile design for a radiant and naturally beautiful result.' },
          { icon: '🩺', title: 'Periodontics', desc: 'Prevention and treatment of gum disease using laser technology and evidence-based protocols.' },
          { icon: '📡', title: 'Digital Diagnostics', desc: '3D CT scans, intraoral scanners and digital X-rays for precise, complete diagnoses.' },
          { icon: '👶', title: 'Paediatric Dentistry', desc: 'Specialist care for children in a friendly, fear-free environment focused on prevention.' },
        ].map(t => (
          <div class="card">
            <div class="card-body">
              <div style="font-size:2rem; margin-bottom:12px;">{t.icon}</div>
              <h3 class="sec-h3" style="margin-bottom:8px;">{t.title}</h3>
              <p class="lead">{t.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <div style="text-align:center; margin-top:36px;">
        <a href="/en/treatments" class="btn btn-outline">View all treatments</a>
      </div>
    </div>
  </div>

  <!-- TESTIMONIALS PREVIEW -->
  <div class="sec-white">
    <div class="section">
      <div class="center" style="margin-bottom:44px;">
        <span class="eyebrow">Testimonials</span>
        <h2 class="sec-h2">What our patients say</h2>
        <div class="divider-bar"></div>
      </div>
      <div class="grid-3">
        {[
          { quote: 'The implant treatment was flawless. The team explained every step in detail and the result exceeded all my expectations. I feel like I have natural teeth.', name: 'María G.', treatment: 'Dental implants' },
          { quote: 'I had been self-conscious about my smile for years and thanks to DDX invisible orthodontics I have regained my confidence. The process was comfortable and results were visible from the first month.', name: 'Carlos M.', treatment: 'Invisalign orthodontics' },
          { quote: 'The care from the very first moment was excellent. Very modern clinic, top-level professionals and a warm approach that makes you go to the dentist without fear.', name: 'Laura P.', treatment: 'Cosmetic dentistry' },
        ].map(t => (
          <div class="testimonial-card">
            <div class="quote-mark">"</div>
            <p class="testimonial-text">{t.quote}</p>
            <div class="testimonial-author">
              <div class="author-name">{t.name}</div>
              <div class="author-treatment">{t.treatment}</div>
              <div class="stars">★★★★★</div>
            </div>
          </div>
        ))}
      </div>
      <div style="text-align:center; margin-top:36px;">
        <a href="/en/testimonials" class="btn btn-outline">Read more testimonials</a>
      </div>
    </div>
  </div>

  <!-- CTA BANNER -->
  <div class="cta-banner">
    <div class="cta-banner-inner">
      <span class="eyebrow-dark">DDX Digital Dental Xperts</span>
      <h2 class="sec-h2-white">Ready to transform your smile?</h2>
      <p class="lead-white" style="margin-top:14px;">Book your appointment today and take the first step towards the smile you've always wanted.</p>
      <div class="cta-actions">
        <a href="/en/appointment" class="btn btn-white btn-lg">Book an appointment</a>
      </div>
    </div>
  </div>

</Layout>
