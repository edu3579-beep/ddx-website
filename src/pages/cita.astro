---
import Layout from '../layouts/Layout.astro';
import { waLink, SITE_CONFIG } from '../config';

const waHref = waLink('es');
const formAction = SITE_CONFIG.formspreeId
  ? `https://formspree.io/f/${SITE_CONFIG.formspreeId}`
  : '#form-not-configured';
---

<Layout title="Pida su cita – DDX Digital Dental Experts" lang="es" description="Solicite su cita en DDX Digital Dental Experts. Formulario online, WhatsApp o teléfono. Respuesta en menos de 24 horas.">

  <!-- PAGE HERO -->
  <div class="page-hero">
    <span class="eyebrow">Contacto</span>
    <h1 class="page-h1">Pida su cita</h1>
    <div class="divider-bar" style="margin:16px auto 0;"></div>
    <p class="lead" style="max-width:520px; margin:16px auto 0;">Estamos aquí para ayudarle. Contáctenos por el medio que prefiera y le responderemos en menos de 24 horas.</p>
  </div>

  <!-- CONTACT OPTIONS STRIP -->
  <div class="sec-light" style="border-bottom:1px solid var(--silver-light);">
    <div class="container">
      <div class="grid-3" style="padding:0;">
        <div class="contact-option">
          <div class="contact-option-icon">📋</div>
          <div class="contact-option-label">Formulario online</div>
          <div class="contact-option-value">
            <a href="#formulario" style="color:var(--accent); font-size:.85rem;">Rellene el formulario →</a>
          </div>
        </div>
        <div class="contact-option" style="border-left:1px solid var(--silver-light); border-right:1px solid var(--silver-light);">
          <div class="contact-option-icon">💬</div>
          <div class="contact-option-label">WhatsApp</div>
          <div class="contact-option-value">
            <a href={waHref} target="_blank" rel="noopener noreferrer" style="color:var(--wa-green); font-size:.85rem;">Escribir ahora →</a>
          </div>
        </div>
        <div class="contact-option">
          <div class="contact-option-icon">📞</div>
          <div class="contact-option-label">Teléfono</div>
          <div class="contact-option-value">{SITE_CONFIG.phone}</div>
        </div>
      </div>
    </div>
  </div>

  <!-- MAIN: FORM + INFO -->
  <div class="sec-white">
    <div class="section">
      <div class="grid-2-3" id="formulario">

        <!-- FORM -->
        <div class="form-card">
          <span class="eyebrow">Solicitud de cita</span>
          <h2 class="sec-h2" style="margin-bottom:28px;">Rellene el formulario</h2>

          <form
            action={formAction}
            method="POST"
            style="display:flex; flex-direction:column; gap:20px;"
          >
            <input type="hidden" name="_next" value="/gracias" />
            <input type="hidden" name="_subject" value="Nueva solicitud de cita – DDX Digital Dental Experts" />

            <div class="form-group">
              <label class="form-label" for="nombre">Nombre completo *</label>
              <input class="form-input" type="text" id="nombre" name="nombre" required placeholder="Su nombre completo" autocomplete="name" />
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label class="form-label" for="telefono">Teléfono *</label>
                <input class="form-input" type="tel" id="telefono" name="telefono" required placeholder="+34 600 000 000" autocomplete="tel" />
              </div>
              <div class="form-group">
                <label class="form-label" for="email">Email *</label>
                <input class="form-input" type="email" id="email" name="email" required placeholder="su@email.com" autocomplete="email" />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="tratamiento">Tratamiento de interés *</label>
              <select class="form-input form-select" id="tratamiento" name="tratamiento" required>
                <option value="" disabled selected>-- Seleccione un tratamiento --</option>
                <option value="implantes">Implantes dentales</option>
                <option value="ortodoncia">Ortodoncia / Invisalign</option>
                <option value="estetica">Estética dental</option>
                <option value="periodoncia">Periodoncia</option>
                <option value="diagnostico">Diagnóstico digital</option>
                <option value="infantil">Odontología infantil</option>
                <option value="primera-consulta">Primera consulta general</option>
                <option value="otro">Otro</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="horario">Horario preferido</label>
              <select class="form-input form-select" id="horario" name="horario">
                <option value="indiferente">Indiferente</option>
                <option value="manana">Mañana (9:00–13:00)</option>
                <option value="tarde">Tarde (15:00–20:00)</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="mensaje">Mensaje o comentarios</label>
              <textarea class="form-input" id="mensaje" name="mensaje" rows="4" placeholder="Cuéntenos brevemente su caso o cualquier duda que tenga…"></textarea>
            </div>

            <div class="form-checkbox-row">
              <input type="checkbox" id="privacidad" name="privacidad" required />
              <label class="form-checkbox-label" for="privacidad">
                He leído y acepto la <a href="/politica-de-privacidad" style="color:var(--accent); text-decoration:underline;">política de privacidad</a>. Consiento el tratamiento de mis datos para gestionar mi solicitud de cita.
              </label>
            </div>

            <button type="submit" class="btn btn-dark btn-full btn-lg">
              Enviar solicitud de cita →
            </button>

            <p style="font-size:.72rem; color:var(--text-muted); text-align:center;">
              Le responderemos en menos de 24 horas en horario laboral.
            </p>
          </form>
        </div>

        <!-- INFO PANEL -->
        <div class="info-panel">

          <!-- WhatsApp block -->
          <div class="info-block info-block-wa">
            <div class="info-heading">¿Prefiere WhatsApp?</div>
            <h3 class="sec-h3" style="margin-bottom:8px;">Escríbanos ahora</h3>
            <p class="lead" style="margin-bottom:16px;">Le respondemos en minutos. También puede enviarnos fotos de su caso para una valoración previa.</p>
            <a href={waHref} target="_blank" rel="noopener noreferrer" class="btn btn-wa btn-full btn-lg">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Abrir WhatsApp
            </a>
          </div>

          <!-- Contact info -->
          <div class="info-block">
            <div class="info-heading">Información de contacto</div>
            <div class="info-row">
              <span class="info-icon">📞</span>
              <span class="info-text">{SITE_CONFIG.phone}</span>
            </div>
            <div class="info-row">
              <span class="info-icon">✉</span>
              <span class="info-text">{SITE_CONFIG.email}</span>
            </div>
            <div class="info-row">
              <span class="info-icon">📍</span>
              <span class="info-text">{SITE_CONFIG.address}<br/>{SITE_CONFIG.city}</span>
            </div>
          </div>

          <!-- Hours -->
          <div class="info-block">
            <div class="info-heading">Horario de atención</div>
            <div class="hours-grid">
              <span class="hours-day">Lun – Vie</span>
              <span class="hours-time">9:00 – 20:00</span>
              <span class="hours-day">Sábado</span>
              <span class="hours-time">9:00 – 14:00</span>
              <span class="hours-day">Domingo</span>
              <span class="hours-time">Cerrado</span>
            </div>
          </div>

          <!-- Map placeholder -->
          <div class="map-placeholder">
            <span>Google Maps embed</span>
          </div>

        </div>
      </div>
    </div>
  </div>

</Layout>
